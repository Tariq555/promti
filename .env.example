# .env.example — copy to .env.local and fill in real values.
# Never commit .env.local. It is ignored by .gitignore.
#
#   cp .env.example .env.local
#
# This list is derived from `grep -rn "process.env" src`. If you add a new
# variable to the code, add it here in the same commit.

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
# Where to get it: Supabase dashboard -> Project Settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / publishable key (starts with sb_publishable_ or eyJ...).
# Where to get it: Supabase dashboard -> Project Settings -> API Keys
#
# NOTE: this key is intentionally public. It is inlined into the browser
# bundle at build time and anyone can read it. Its safety depends entirely
# on Row Level Security being correct. Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
